{
  "expo": {
    "name": "ABC Doctor",
    "slug": "abc-doctor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "abc.qla.dev",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The camera is used to capture lecture slides and textbook pages to turn into flashcards.",
        "NSMicrophoneUsageDescription": "The microphone is used for spoken consultations with the AI tutor and simulated patients.",
        "NSPhotoLibraryUsageDescription": "Choose an image of study material to turn into flashcards."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "abc.qla.dev",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-audio",
      "expo-image"
    ],
    "scheme": "abcdoctor",
    "owner": "qla-dev",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "323d1cfb-6bdb-4145-ab71-06be95eca9ff"
      }
    }
  }
}

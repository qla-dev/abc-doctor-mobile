{
  "expo": {
    "name": "ABC Doctor",
    "slug": "abc-doctor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "abc.qla.dev",
      "userInterfaceStyle": "automatic",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The camera is used to capture lecture slides and textbook pages to turn into flashcards.",
        "NSMicrophoneUsageDescription": "The microphone is used for spoken consultations with the AI tutor and simulated patients.",
        "NSPhotoLibraryUsageDescription": "Choose an image of study material to turn into flashcards."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.abc.qla.dev"
        ]
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "abc.qla.dev",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "INTERNET"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/323d1cfb-6bdb-4145-ab71-06be95eca9ff",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-webrtc",
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "expo-task-manager",
      "expo-navigation-bar",
      "expo-system-ui",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "ABC Doctor uses the microphone for spoken consultations with the AI tutor and simulated patients."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ABC Doctor uses the camera to capture lecture slides and textbook pages and turn them into flashcards.",
          "microphonePermission": "ABC Doctor uses the microphone for spoken consultations.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image of study material to turn into flashcards."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007AFF",
          "defaultChannel": "reviews"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-updates",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ABC Doctor to hear spoken conversation turns.",
          "speechRecognitionPermission": "Allow ABC Doctor to transcribe spoken conversation turns."
        }
      ]
    ],
    "scheme": "abcdoctor",
    "owner": "qla-dev",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "323d1cfb-6bdb-4145-ab71-06be95eca9ff"
      },
      "googleAuth": {
        "webClientId": "338186716107-j8ifac27k51mlucgmjd9d4hohaarpsef.apps.googleusercontent.com",
        "iosClientId": "338186716107-kcqu0kisks6ir0hjp0kbj4d544fouupt.apps.googleusercontent.com",
        "androidClientId": "338186716107-hbl7oa630j5ir50eu1tmt36b4ojr1tk2.apps.googleusercontent.com"
      },
      "revenueCat": {
        "iosApiKey": "appl_XvLvuCqeciwhjJTzMqKnqqgNZFi",
        "androidApiKey": "goog_mArwiVdtqvrfQpPRLmgLSSyFfIm",
        "entitlementIdentifier": "ABC Doctor Pro",
        "offeringIdentifier": "tokens"
      }
    }
  }
}

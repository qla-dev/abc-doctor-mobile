{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "26.3.0"
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "26.3.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "26.3.0",
      "env": {
        "EXPO_PUBLIC_API_BACKEND": "production"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "node": "26.3.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BACKEND": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

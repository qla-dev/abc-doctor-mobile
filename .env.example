# Which backend the app talks to. Keys come from API_BACKENDS in lib/api.ts.
#   local      -> http://127.0.0.1:8000/api   (php artisan serve, in backend/)
#   production -> https://abc.qla.dev/api     (nothing deployed there yet)
EXPO_PUBLIC_API_BACKEND=local

# Overrides the map outright. Native needs this on a real device: 127.0.0.1 is the host machine
# on the iOS simulator but the phone itself on hardware, so point it at your LAN address.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
